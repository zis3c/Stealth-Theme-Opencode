{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "darkBg": "transparent",
    "darkPanel": "transparent",
    "darkElement": "transparent",
    "darkMenu": "transparent",
    "darkBorder": "#3a3a3a",
    "darkBorderActive": "#6f6f6f",
    "darkBorderSubtle": "#2a2a2a",
    "darkText": "#c6c6c6",
    "darkMuted": "#7a7a7a",
    "darkFaint": "#5e5e5e",
    "lightBg": "transparent",
    "lightPanel": "transparent",
    "lightElement": "transparent",
    "lightMenu": "transparent",
    "lightBorder": "#c4c4c4",
    "lightBorderActive": "#8a8a8a",
    "lightBorderSubtle": "#dcdcdc",
    "lightText": "#2a2a2a",
    "lightMuted": "#6a6a6a",
    "lightFaint": "#8a8a8a"
  },
  "theme": {
    "primary": {
      "dark": "darkText",
      "light": "lightText"
    },
    "secondary": {
      "dark": "darkMuted",
      "light": "lightMuted"
    },
    "accent": {
      "dark": "#d0d0d0",
      "light": "#1a1a1a"
    },
    "error": {
      "dark": "#b0b0b0",
      "light": "#333333"
    },
    "warning": {
      "dark": "#a0a0a0",
      "light": "#4a4a4a"
    },
    "success": {
      "dark": "#8f8f8f",
      "light": "#4a4a4a"
    },
    "info": {
      "dark": "#9a9a9a",
      "light": "#4a4a4a"
    },
    "text": {
      "dark": "darkText",
      "light": "lightText"
    },
    "textMuted": {
      "dark": "darkMuted",
      "light": "lightMuted"
    },
    "selectedListItemText": {
      "dark": "#e0e0e0",
      "light": "#111111"
    },
    "background": {
      "dark": "darkBg",
      "light": "lightBg"
    },
    "backgroundPanel": {
      "dark": "darkPanel",
      "light": "lightPanel"
    },
    "backgroundElement": {
      "dark": "darkElement",
      "light": "lightElement"
    },
    "backgroundMenu": {
      "dark": "darkMenu",
      "light": "lightMenu"
    },
    "border": {
      "dark": "darkBorder",
      "light": "lightBorder"
    },
    "borderActive": {
      "dark": "darkBorderActive",
      "light": "lightBorderActive"
    },
    "borderSubtle": {
      "dark": "darkBorderSubtle",
      "light": "lightBorderSubtle"
    },
    "diffAdded": {
      "dark": "#9c9c9c",
      "light": "#3a3a3a"
    },
    "diffRemoved": {
      "dark": "#707070",
      "light": "#5a5a5a"
    },
    "diffContext": {
      "dark": "darkMuted",
      "light": "lightMuted"
    },
    "diffHunkHeader": {
      "dark": "#8a8a8a",
      "light": "#5a5a5a"
    },
    "diffHighlightAdded": {
      "dark": "#b8b8b8",
      "light": "#2a2a2a"
    },
    "diffHighlightRemoved": {
      "dark": "#8a8a8a",
      "light": "#4a4a4a"
    },
    "diffAddedBg": {
      "dark": "#1b1b1b",
      "light": "#f0f0f0"
    },
    "diffRemovedBg": {
      "dark": "#1b1b1b",
      "light": "#f0f0f0"
    },
    "diffContextBg": {
      "dark": "darkPanel",
      "light": "lightPanel"
    },
    "diffLineNumber": {
      "dark": "darkFaint",
      "light": "lightFaint"
    },
    "diffAddedLineNumberBg": {
      "dark": "#1b1b1b",
      "light": "#f0f0f0"
    },
    "diffRemovedLineNumberBg": {
      "dark": "#1b1b1b",
      "light": "#f0f0f0"
    },
    "markdownText": {
      "dark": "darkText",
      "light": "lightText"
    },
    "markdownHeading": {
      "dark": "#d0d0d0",
      "light": "#1a1a1a"
    },
    "markdownLink": {
      "dark": "#b0b0b0",
      "light": "#3a3a3a"
    },
    "markdownLinkText": {
      "dark": "#a0a0a0",
      "light": "#4a4a4a"
    },
    "markdownCode": {
      "dark": "#b8b8b8",
      "light": "#2a2a2a"
    },
    "markdownBlockQuote": {
      "dark": "darkMuted",
      "light": "lightMuted"
    },
    "markdownEmph": {
      "dark": "#b0b0b0",
      "light": "#3a3a3a"
    },
    "markdownStrong": {
      "dark": "#d0d0d0",
      "light": "#1a1a1a"
    },
    "markdownHorizontalRule": {
      "dark": "darkFaint",
      "light": "lightFaint"
    },
    "markdownListItem": {
      "dark": "darkText",
      "light": "lightText"
    },
    "markdownListEnumeration": {
      "dark": "#a0a0a0",
      "light": "#4a4a4a"
    },
    "markdownImage": {
      "dark": "#b0b0b0",
      "light": "#3a3a3a"
    },
    "markdownImageText": {
      "dark": "#a0a0a0",
      "light": "#4a4a4a"
    },
    "markdownCodeBlock": {
      "dark": "darkText",
      "light": "lightText"
    },
    "syntaxComment": {
      "dark": "darkFaint",
      "light": "lightFaint"
    },
    "syntaxKeyword": {
      "dark": "#c0c0c0",
      "light": "#1a1a1a"
    },
    "syntaxFunction": {
      "dark": "#b0b0b0",
      "light": "#3a3a3a"
    },
    "syntaxVariable": {
      "dark": "darkText",
      "light": "lightText"
    },
    "syntaxString": {
      "dark": "#a8a8a8",
      "light": "#4a4a4a"
    },
    "syntaxNumber": {
      "dark": "#b8b8b8",
      "light": "#2a2a2a"
    },
    "syntaxType": {
      "dark": "#b0b0b0",
      "light": "#3a3a3a"
    },
    "syntaxOperator": {
      "dark": "#9a9a9a",
      "light": "#4a4a4a"
    },
    "syntaxPunctuation": {
      "dark": "darkText",
      "light": "lightText"
    },
    "thinkingOpacity": 0.5
  }
}
